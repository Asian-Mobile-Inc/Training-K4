<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvUserItemId"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_white"
        android:padding="8dp"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvUserItemName"
        app:layout_constraintEnd_toStartOf="@id/tvUserItemName"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvUserItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_grey"
        android:padding="8dp"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/tvUserItemAge"
        app:layout_constraintHorizontal_weight="6"
        app:layout_constraintStart_toEndOf="@id/tvUserItemId"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvUserItemAge"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_grey"
        android:padding="8dp"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvUserItemName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintStart_toEndOf="@id/tvUserItemName"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnEditItemUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/edit"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteItemUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUserItemName" />

    <Button
        android:id="@+id/btnDeleteItemUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnEditItemUser"
        app:layout_constraintTop_toBottomOf="@id/tvUserItemName" />
</androidx.constraintlayout.widget.ConstraintLayout>
